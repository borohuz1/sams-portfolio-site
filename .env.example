# Copy this file to .env and fill in what you need.
# Everything here is optional, the site runs with an empty file.

# Where the optional server lives (leaderboard, whispers). Leave empty to run
# fully offline, the site works without it.
VITE_SERVER_URL=

# Google Analytics tag. Leave empty to have no analytics at all.
VITE_ANALYTICS_TAG=

# Expose the game as window.game so you can poke at it in the console.
VITE_GAME_PUBLIC=1

# Compressed assets. LEAVE THIS EMPTY.
# Turn it on only if you have regenerated the -compressed.glb models and the
# .ktx textures. See the "Compressed builds" section of README.md.
VITE_COMPRESSED=

# Force a point in the day cycle, 0 to 1. Leave empty for the normal cycle.
VITE_DAY_CYCLE_PROGRESS=

# Force a point in the year cycle, 0 to 1. Leave empty for the normal cycle.
VITE_YEAR_CYCLE_PROGRESS=

# How many whispers to keep.
VITE_WHISPERS_COUNT=30

# Play music in the background. 1 = on, 0 = off.
VITE_MUSIC=1

# Print the welcome banner in the console.
VITE_LOG=1

# Force the player to spawn at a given respawn point.
VITE_PLAYER_SPAWN=
