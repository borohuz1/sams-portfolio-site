.home-content
    .zones-list
        list-style none
        margin 0 0 2rem
        padding 0

        .zone
            display flex
            flex-wrap wrap
            align-items baseline
            gap 4px 8px
            margin-bottom 14px

            strong
                color #ffceca
                font-size 1.4rem
                letter-spacing .04em
                text-transform capitalize

            .zone-detail
                font-size 1.25rem
                opacity .8

            .zone-period
                margin-left auto
                font-size 1.1rem
                font-style italic
                opacity .6

            .zone-description
                flex-basis 100%
                font-size 1.25rem
                line-height 1.45
                opacity .75

    .tools-list
        list-style none
        display flex
        flex-wrap wrap
        gap 8px
        margin 0
        padding 0

        .tool
            display flex
            align-items center
            gap 8px
            border 1px solid #ffceca
            border-radius 999px
            padding 5px 14px

            strong
                font-size 1.25rem
                font-weight 700

            .tool-status
                font-size 1rem
                letter-spacing .1em
                text-transform uppercase
                opacity .65

            &.is-learning
                opacity .6
                border-style dashed
